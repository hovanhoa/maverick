# Copy this file to deployment/.env and adjust as needed.
# docker compose (and `go run ./cmd/api`) will pick these up.

# Selects code paths in pkg/core/env (e.g. disables Redis TLS for local dev).
# Leave as `dev` for local docker-compose.
ENVIRONMENT=dev

# ---- Postgres ---------------------------------------------------------------
# Host/port from the perspective of the API process. When running the API
# inside the compose network, override DB_HOST=postgres (already done in the
# compose file). For `go run` locally, keep localhost.
DB_HOST=localhost
DB_PORT=5432
DB_USER=llmgateway
DB_PASS=llmgateway
DB_NAME=llmgateway

# ---- Redis ------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# The redis container generates its ACL from this value at startup and the
# API client (pkg/driver/redis) authenticates as `redis` with this password.
REDIS_PASS=localdev

# ---- LLM providers (Phase 3) -------------------------------------------------
# Backs the OpenAI-compatible proxy at POST /v1/chat/completions. Each key is
# optional - a provider is only registered (and only then callable via
# "<provider>/<model>" in the request body) when its key is set. Leave unset
# to disable that provider entirely.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Bedrock and Vertex AI are scaffolded (see internal/provider/bedrock and
# internal/provider/vertexai) but not yet implemented - they need AWS SigV4
# and GCP OAuth2 respectively, not a simple API key.
