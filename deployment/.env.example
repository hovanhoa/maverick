# Copy this file to deployment/.env and adjust as needed.
# docker compose (and `go run ./cmd/api`) will pick these up.

# Selects code paths in pkg/core/env (e.g. disables Redis TLS for local dev).
# Leave as `dev` for local docker-compose.
ENVIRONMENT=dev

# ---- Postgres ---------------------------------------------------------------
# Host/port from the perspective of the API process. When running the API
# inside the compose network, override DB_HOST=postgres (already done in the
# compose file). For `go run` locally, keep localhost.
DB_HOST=localhost
DB_PORT=5432
DB_USER=llmgateway
DB_PASS=llmgateway
DB_NAME=llmgateway

# ---- Redis ------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# The redis container generates its ACL from this value at startup and the
# API client (pkg/driver/redis) authenticates as `redis` with this password.
REDIS_PASS=localdev
